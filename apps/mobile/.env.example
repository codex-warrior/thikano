# Production — set in EAS (eas env:create) or .env.production; never commit real values.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Build-time (EAS env): reversed iOS client ID, e.g. com.googleusercontent.apps.123-abc
GOOGLE_IOS_URL_SCHEME=
# Set to 1 once an SMS provider is configured to offer phone OTP sign-in
EXPO_PUBLIC_PHONE_LOGIN=
