{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_FIREBASE_EMULATOR_HOST": "10.0.2.2" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_FIREBASE_EMULATOR_HOST": "" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_FIREBASE_EMULATOR_HOST": "" }
    }
  },
  "submit": { "production": {} }
}
