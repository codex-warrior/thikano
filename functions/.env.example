# Non-secret Cloud Functions config. Copy to functions/.env.<project-id> before deploying.
# Secrets are NOT set here — use: firebase functions:secrets:set <NAME>
#   OTP_HMAC_SECRET (≥32 random chars) · MSG91_AUTH_KEY · RAZORPAY_KEY_ID · RAZORPAY_KEY_SECRET
#   RAZORPAY_WEBHOOK_SECRET · APNS_KEY (contents of the .p8 file)

PUBLIC_WEB_URL=https://thikano.in

# Phone OTP via MSG91 (DLT template with one OTP variable)
SMS_PROVIDER=msg91
MSG91_OTP_TEMPLATE_ID=
MSG91_OTP_VAR=otp
# Confirm this endpoint in the MSG91 panel at activation (see docs/THIKANO-LAUNCH.md)
MSG91_FLOW_URL=https://control.msg91.com/api/v5/flow

# Payments: off | test | razorpay
PAYMENTS_MODE=razorpay

# iOS push (APNs token auth)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=in.thikano.app
APNS_PRODUCTION=true

# Dwarpar (live ordering once API docs + key are available)
DWARPAR_API_BASE=

# Public callables: enforce App Check (enable once web reCAPTCHA Enterprise + mobile attestation are set up)
THIKANO_ENFORCE_APP_CHECK=false
